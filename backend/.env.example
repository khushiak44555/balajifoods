# Copy this file to .env and fill in real values. Never commit .env.

# MongoDB Atlas connection string (Atlas > Database > Connect > Drivers)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/balaji_foods?retryWrites=true&w=majority

# Port for the API server
PORT=5000

# Comma-separated list of browser origins allowed to call the API during development.
# Not needed when the backend serves the built frontend (same origin).
CORS_ORIGIN=http://localhost:5173
